# Local server configuration
PORT="3000"
NODE_ENV="development"

# Optional server-side Google Safe Browsing Lookup API v5 key.
# Keep this value secret; never expose it to browser code.
GOOGLE_SAFE_BROWSING_API_KEY=""

# Optional server-side Microlink API key for on-demand screenshot rendering.
SCREENSHOT_API_KEY=""

# Set false when the app is directly exposed (including local development).
# Set to 1 only behind exactly one trusted reverse-proxy hop.
TRUST_PROXY="false"

# Required in production for shared rate limits across serverless instances.
# Create an Upstash Redis database and use its REST URL and token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
